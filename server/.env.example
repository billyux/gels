PORT=3000
JWT_SECRET=change-this-to-a-random-secret
# 비워두면 /api/ai-chat이 안내 문구를 목업으로 반환합니다.
GEMINI_API_KEY=

# 비워두면 server/data/gels.db (로컬 파일)를 사용합니다.
# Render 등 디스크가 휘발성인 곳에 배포할 때는 Turso(무료, 영구 저장) 값을 채워주세요.
# turso db show <db이름> --url / turso db tokens create <db이름> 으로 발급받습니다.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
